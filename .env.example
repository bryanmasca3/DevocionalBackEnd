# ===== Servidor =====
NODE_ENV=development          # development | production (en production se ocultan los stack traces)
PORT=1233
HOST=                         # opcional: interfaz de red donde escucha (ej. 0.0.0.0). NO es la URL pública; normalmente vacío

# ===== Base de datos (OBLIGATORIA) =====
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/devocional

# ===== Autenticación (OBLIGATORIA) =====
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
TOKEN_JWT=
TOKEN_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10
DEFAULT_USER_PASSWORD=        # opcional: contraseña inicial si se crea un usuario sin contraseña

# ===== Roles =====
# descripcion(es) de tipoUsuario con permisos de administrador (separados por coma)
ADMIN_ROLES=adminitrador

# ===== Login =====
LOGIN_MAX_ATTEMPTS=5          # intentos fallidos permitidos por IP+correo
LOGIN_WINDOW_MINUTES=15       # ventana de bloqueo
TRUST_PROXY=                  # 1 si la API está detrás de un proxy (Render, Nginx, cPanel)

# ===== CORS (separados por coma) =====
CORS_ORIGINS=http://localhost:5173

# ===== SSL (solo si se habilita HTTPS en server.js) =====
SSL_PATH_PRIVATEKEY=
SSL_PATH_CERTIFICATE=
SSL_PATH_BUNDLE=
